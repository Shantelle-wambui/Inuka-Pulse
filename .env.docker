# .env.docker — environment variables for docker-compose
#
# Usage:
#   cp .env.docker .env
#   # edit .env with your real values
#   docker compose up --build
#
# .env is gitignored. Never commit real secrets.
# This file is the example/template — safe to commit.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=inuka_pulse
POSTGRES_USER=inuka
POSTGRES_PASSWORD=inuka               # change this in production

# ── Spring Boot Backend ───────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=changeme-replace-this-with-a-real-secret-min-40-chars

# Frontend origin allowed to call the backend API (CORS).
# For local Docker: http://localhost:3000
# For VPS with a domain: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
# The URL the BROWSER uses to reach the backend.
# For local Docker: http://localhost:8080
# For VPS with a domain and reverse proxy: https://api.yourdomain.com
NEXT_PUBLIC_INUKA_API_URL=http://localhost:8080

# ── ETL (optional overrides) ─────────────────────────────────────────────────
# Leave ETL_LIVE_BATCH_URL and ETL_PREDICTIONS_URL blank when running with
# Docker Compose — the pipeline writes directly to the shared volume and the
# backend reads from it. Only set these if you switch to the R2 pull model.
ETL_LIVE_BATCH_URL=
ETL_PREDICTIONS_URL=
ETL_API_KEY=

# ── LLM narrative enhancement (optional) ─────────────────────────────────────
# Get a free key at https://console.groq.com
# Leave blank to use template-based narratives (no LLM calls).
GROQ_API_KEY=
LLM_ENABLED=true
