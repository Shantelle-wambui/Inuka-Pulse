{
  "expo": {
    "name": "Inuka Pulse",
    "slug": "inuka-pulse-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "inuka-pulse",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.inukafoundation.pulse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "org.inukafoundation.pulse"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b670383f-b5f3-4ee0-9dc6-f4dba306f068"
      }
    },
    "owner": "shan2804s-team"
  }
}
